{
  "schema_version": "secret-custody-host-hardening-plan-v1",
  "status": "review_only",
  "authorized_for_live_apply": false,
  "target": {
    "provider": "amazon_lightsail",
    "region": "ap-northeast-1",
    "memory_gib": 1,
    "vcpus": 2,
    "storage_gib": 40,
    "transfer_tb": 2,
    "max_monthly_usd": 7,
    "static_ipv4_required": true,
    "automatic_resize_allowed": false,
    "region_substitution_allowed": false
  },
  "preconditions": {
    "h1_read_only_preflight_passed": true,
    "host_still_no_secret": true,
    "cgroup_v2_required": true,
    "swap_must_be_disabled": true,
    "unexpected_wildcard_listener_allowed": false,
    "required_tooling_must_be_present": true
  },
  "runtime_identity": {
    "dedicated_non_login_identity_required": true,
    "sudo_allowed": false,
    "container_daemon_control_allowed": false,
    "package_manager_allowed": false,
    "cloud_metadata_credentials_allowed": false
  },
  "filesystem": {
    "runtime_config_root_owned": true,
    "group_world_writable_config_allowed": false,
    "application_code_runtime_writable": false,
    "bounded_private_runtime_directory_required": true,
    "ephemeral_memory_secret_handoff_only": true
  },
  "systemd": {
    "service_enabled_before_qualification": false,
    "no_new_privileges": true,
    "protect_system_strict": true,
    "protect_home": true,
    "private_tmp": true,
    "core_dumps_disabled": true,
    "memory_limit_required": true,
    "pids_limit_required": true,
    "cpu_limit_required": true,
    "explicit_writable_path_allowlist_required": true,
    "kill_complete_process_tree_on_failure": true
  },
  "network": {
    "public_http_allowed": false,
    "public_https_allowed": false,
    "public_runtime_listener_allowed": false,
    "runtime_default_deny_egress_required": true,
    "world_open_ipv4_allowed": false,
    "world_open_ipv6_allowed": false,
    "bootstrap_and_runtime_egress_must_be_separate": true,
    "dns_drift_must_not_widen_egress": true
  },
  "logging": {
    "credential_values_allowed": false,
    "connection_strings_allowed": false,
    "sql_bind_values_allowed": false,
    "secret_environment_values_allowed": false,
    "private_allowlist_addresses_allowed": false,
    "provider_account_identifiers_allowed": false,
    "metadata_only": true,
    "bounded": true
  },
  "postconditions_before_trust": {
    "service_identity_verified": true,
    "filesystem_ownership_verified": true,
    "systemd_sandbox_verified": true,
    "swap_disabled_verified": true,
    "no_unexpected_wildcard_listener_verified": true,
    "default_deny_egress_verified": true,
    "approved_egress_verified": true,
    "unapproved_egress_rejected": true,
    "reboot_persistence_verified": true,
    "no_oom_kill_verified": true,
    "process_tree_cleanup_verified": true,
    "log_redaction_verified": true
  },
  "runtime_gates": {
    "hosted_task_execution_enabled": false,
    "provider_generation_write_enabled": false,
    "scheduler_recurrence_enabled": false,
    "report_delivery_enabled": false,
    "production_prediction_enabled": false,
    "prediction_db_write_enabled": false,
    "external_race_data_fetch_enabled": false
  },
  "secret_policy": {
    "aws_access_key_present": false,
    "private_ssh_key_present": false,
    "supabase_service_key_present": false,
    "database_password_present": false,
    "vault_secret_present": false,
    "provider_credential_present": false,
    "refresh_token_present": false
  },
  "rollback": {
    "valid_only_before_real_credential_or_c2_binding": true,
    "runtime_must_remain_disabled": true,
    "remove_runtime_egress_allowances_first": true,
    "require_no_active_runtime_process": true,
    "preserve_sanitized_failure_evidence": true,
    "must_not_touch_supabase_schema_or_vault": true,
    "must_not_touch_prediction_or_race_data": true
  }
}
