{
  "schema_version": "secret-custody-host-recovery-plan-v1",
  "status": "review_only",
  "authorized_for_live_recovery": false,
  "scope": {
    "pre_real_credential_only": true,
    "pre_c2_binding_only": true,
    "host_must_remain_no_secret": true,
    "runtime_must_remain_disabled": true,
    "active_runtime_process_allowed": false
  },
  "failure_classes": {
    "preflight_mismatch": "stop_and_preserve_sanitized_evidence",
    "hardening_verification_failure": "keep_untrusted_and_disabled",
    "network_tls_failure": "stop_without_network_relaxation",
    "capacity_failure": "reject_candidate_without_weakening_controls",
    "reboot_recovery_failure": "keep_untrusted_and_disabled"
  },
  "protected_domains": {
    "supabase_custody_schema_touch_allowed": false,
    "vault_touch_allowed": false,
    "provider_account_touch_allowed": false,
    "prediction_state_touch_allowed": false,
    "race_data_touch_allowed": false,
    "runtime_checkpoint_queue_touch_allowed": false
  },
  "aws_recovery": {
    "automatic_instance_delete_allowed": false,
    "automatic_instance_resize_allowed": false,
    "automatic_instance_reboot_allowed": false,
    "automatic_snapshot_allowed": false,
    "automatic_replacement_allowed": false,
    "separate_live_authorization_required": true
  },
  "network_recovery": {
    "automatic_firewall_relaxation_allowed": false,
    "automatic_egress_widening_allowed": false,
    "world_open_ipv4_allowed": false,
    "world_open_ipv6_allowed": false,
    "plaintext_database_fallback_allowed": false,
    "insecure_tls_fallback_allowed": false
  },
  "rollback_invariants": {
    "remove_runtime_egress_allowances_before_relaxing_isolation": true,
    "prove_no_active_runtime_process_before_identity_cleanup": true,
    "preserve_sanitized_failure_evidence": true,
    "do_not_touch_supabase_or_vault": true,
    "do_not_touch_prediction_or_race_data": true,
    "do_not_introduce_credentials_during_recovery": true
  },
  "evidence": {
    "metadata_only": true,
    "live_ip_allowlists_allowed": false,
    "aws_account_identifiers_allowed": false,
    "private_hostnames_allowed": false,
    "connection_strings_allowed": false,
    "environment_values_allowed": false,
    "credential_values_allowed": false,
    "provider_account_identifiers_allowed": false,
    "prediction_snapshots_allowed": false,
    "race_histories_allowed": false
  },
  "runtime_gates": {
    "hosted_task_execution_enabled": false,
    "provider_generation_write_enabled": false,
    "scheduler_recurrence_enabled": false,
    "report_delivery_enabled": false,
    "production_prediction_enabled": false,
    "prediction_db_write_enabled": false,
    "external_race_data_fetch_enabled": false
  }
}
